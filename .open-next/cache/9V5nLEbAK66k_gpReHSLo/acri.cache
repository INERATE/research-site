{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/(papers)/layout,_N_T_/(papers)/acri/layout,_N_T_/(papers)/acri/page,_N_T_/acri"},"segmentPaths":["/_tree","/_full","/!KHBhcGVycyk/acri/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" data-theme=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/39stuv2m4gmil.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/2x8myol6nmed-.js\"/><script src=\"/_next/static/chunks/141-l84vaz-cv.js\" async=\"\"></script><script src=\"/_next/static/chunks/069t_d29odbb_.js\" async=\"\"></script><script src=\"/_next/static/chunks/0271_cfnfufov.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0cxxsy-3ojawx.js\" async=\"\"></script><script src=\"/_next/static/chunks/0acj2lgx71t4d.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/3tmzu7inn0yee.js\" async=\"\" crossorigin=\"\"></script><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&amp;family=Inter:wght@300;400;500;600;700;800&amp;family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" as=\"style\"/><title>INERATE Research — Advancing AI Systems &amp; Capability Microkernels</title><meta name=\"description\" content=\"Official research publication portal for INERATE. Featuring client-side capability microkernels, deterministic prompt caching economics, and autonomous agent architectures.\"/><meta property=\"og:title\" content=\"acri: A Client-Side Capability Resolver for Tool-Augmented Language Models\"/><meta property=\"og:description\" content=\"40µs in-memory capability resolution microkernel. Cuts prompt tokens by 95%, boosts Gemini 2.5 Flash accuracy from 84% to 92%.\"/><meta property=\"og:url\" content=\"https://research.inerate.com\"/><meta property=\"og:site_name\" content=\"INERATE Research\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"INERATE Research — Capability Microkernels for AI Agents\"/><meta name=\"twitter:description\" content=\"40µs client-side tool resolution for LLMs without native tool search.\"/><link rel=\"icon\" href=\"/assets/research-mark.svg\"/><link rel=\"apple-touch-icon\" href=\"/assets/research-mark.svg\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&amp;family=Inter:wght@300;400;500;600;700;800&amp;family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div style=\"background:#FFFFFF;min-height:100vh;color:#202124\"><header class=\"g-header\"><div class=\"research-container g-nav-inner\"><a class=\"g-brand\" href=\"/\"><div style=\"display:flex;align-items:center\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" style=\"margin-right:6px\"><circle cx=\"12\" cy=\"12\" r=\"9.5\" stroke=\"#1A73E8\" stroke-width=\"1.75\" stroke-dasharray=\"2 3\"></circle><circle cx=\"12\" cy=\"12\" r=\"5\" stroke=\"#EA4335\" stroke-width=\"1.5\"></circle><rect x=\"10\" y=\"10\" width=\"4\" height=\"4\" rx=\"1\" fill=\"#34A853\"></rect></svg></div><span style=\"font-weight:600;color:#202124\">INERATE</span><span style=\"color:#5F6368;font-weight:400;margin-left:2px\">Research</span></a><nav class=\"g-nav-links\"><a class=\"g-nav-link\" href=\"/\">Research</a><a class=\"g-nav-link active\" href=\"/acri\">Publications</a><a href=\"https://forge.inerate.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"g-nav-link\">Forge</a><a href=\"https://docs.inerate.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"g-nav-link\">Docs</a><a href=\"https://github.com/INERATE/acri\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"g-nav-link\">GitHub</a><button type=\"button\" class=\"g-search-btn\" aria-label=\"Search Research\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg><span>Search</span></button></nav></div></header><main class=\"research-container\"><div class=\"g-breadcrumbs\"><a href=\"/\">Home</a><span>&gt;</span><a href=\"/\">Publications</a><span>&gt;</span><span>Capability Microkernels</span></div><section class=\"g-hero\"><div><h1 class=\"g-title\">acri: A Client-Side Capability Resolver for Tool-Augmented Language Models</h1><div class=\"g-meta-date\">August 27, 2026 · Technical Report · 12 min read</div><div class=\"g-meta-authors\">Piyush Sharma, Research Engineer, <a href=\"https://github.com/INERATE\" target=\"_blank\" rel=\"noopener noreferrer\">INERATE Research</a></div><div style=\"display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:24px\"><button type=\"button\" class=\"g-btn-primary\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline></svg>Read Paper (PDF)</button><button type=\"button\" class=\"g-btn-secondary\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"></path><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"></path></svg>Cite (BibTeX)</button><a href=\"https://github.com/INERATE/acri\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"g-btn-secondary\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.94c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.18a11 11 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.05.78 2.13v3.16c0 .3.2.67.8.55A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z\"></path></svg>GitHub</a><a href=\"https://inerate.github.io/acri/demo/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"g-btn-secondary\">Interactive Demo ⚡</a></div></div><div class=\"g-hero-card\"><svg viewBox=\"0 0 300 190\" width=\"82%\" style=\"overflow:visible\"><circle cx=\"14\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"38\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"62\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"86\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"110\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"134\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"158\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"182\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"206\" cy=\"14\" r=\"2.6\" fill=\"#DADCE0\" opacity=\"0.85\"></circle><circle cx=\"230\" cy=