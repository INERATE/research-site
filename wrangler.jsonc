{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-site",
  "account_id": "09fc9d2f5f1796915f66c4cd4302d111",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "research.inerate.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
